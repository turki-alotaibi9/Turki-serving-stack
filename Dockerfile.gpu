FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Create non-root user
RUN useradd --create-home app
ENV HF_HOME=/home/app/.cache/huggingface

# Install system-level Python 3 and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY app/requirements.txt .

# Install dependencies using the pinned PyTorch CUDA wheel index
RUN pip3 install --no-cache-dir --default-timeout=1000 -r requirements.txt

COPY app/ .

# Adjust permissions for non-root user
RUN mkdir -p /home/app/.cache/huggingface \
    && chown -R app:app /home/app/.cache /app

USER app

EXPOSE 8000

CMD ["python3", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]